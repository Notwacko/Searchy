#!/bin/bash
# Dev helper: launch a build as its own isolated, INVISIBLE instance (own data folder, own debug channel).
# usage: scripts/launch-isolated <path/to/Searchy.app> <home-dir>     prints the new pid
# Set SEARCHY_VISIBLE=1 to see the window (only when you are deliberately demoing).
APP="$1"; HOME_DIR="$2"; mkdir -p "$HOME_DIR"
if [ "$SEARCHY_VISIBLE" = "1" ]; then HL=0; else HL=1; fi
SEARCHY_HOME="$HOME_DIR" SEARCHY_DEBUG=1 SEARCHY_HEADLESS=$HL "$APP/Contents/MacOS/Searchy" -ApplePersistenceIgnoreState YES >"$HOME_DIR/stdout.log" 2>&1 &
echo $!
